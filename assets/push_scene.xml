<!--
  Stage 1 scene: a simplified two-link finger at fixed height pushes a free block
  on a table toward a green target square.

  Contact bits: table (1,0), block (1,3), finger (2,0)
    -> block touches table and finger; finger never touches table.
-->
<mujoco model="finger_push">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="2048"/>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.35 0.35 0.35" specular="0 0 0"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.82 0.82 0.80" rgb2="0.74 0.74 0.72"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance="0.05"/>
  </asset>

  <default>
    <default class="finger">
      <geom type="capsule" size="0.008" mass="0.03" rgba="0.92 0.72 0.6 1"
            contype="2" conaffinity="0" friction="0.8 0.01 0.001"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.1 -0.3 1.2" dir="0 0.25 -1" directional="true" castshadow="true"
           diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
    <geom name="table" type="plane" size="0.5 0.5 0.01" material="grid"
          contype="1" conaffinity="0"/>

    <!-- target region: visual only -->
    <geom name="target" type="box" size="0.035 0.035 0.0005" pos="0.25 0 0.0005"
          rgba="0.2 0.8 0.3 0.6" contype="0" conaffinity="0"/>

    <body name="block" pos="0.05 0 0.025">
      <freejoint name="block"/>
      <geom name="block" type="box" size="0.025 0.025 0.025" mass="0.2"
            rgba="0.2 0.4 0.9 1" friction="0.6 0.01 0.001" contype="1" conaffinity="3"/>
    </body>

    <!-- finger base: planar x/y slide + yaw, fixed height z=0.02 -->
    <body name="finger_base" pos="0 0 0.02">
      <joint name="fx" type="slide" axis="1 0 0" damping="10"/>
      <joint name="fy" type="slide" axis="0 1 0" damping="10"/>
      <joint name="fyaw" type="hinge" axis="0 0 1" damping="0.1" armature="0.001"/>
      <geom name="knuckle" type="sphere" size="0.012" mass="0.05"
            rgba="0.85 0.65 0.55 1" contype="0" conaffinity="0"/>
      <geom name="proximal" class="finger" fromto="0 0 0 0.05 0 0"/>
      <body name="distal" pos="0.05 0 0">
        <!-- finger bend: curls in the horizontal plane -->
        <joint name="fbend" type="hinge" axis="0 0 1" range="-1.4 1.4" limited="true"
               damping="0.03" armature="0.0005"/>
        <geom name="distal" class="finger" fromto="0 0 0 0.035 0 0"/>
        <site name="tip" pos="0.035 0 0" size="0.004" rgba="1 0.2 0.2 1"/>
      </body>
    </body>

    <body name="view_center" pos="0.1 0 0"/>
    <camera name="top" mode="fixed" pos="0.1 0 1.0" xyaxes="1 0 0 0 1 0"
            projection="orthographic" fovy="0.7"/>
    <camera name="persp" mode="targetbody" target="view_center" pos="-0.25 -0.45 0.4"/>
  </worldbody>

  <actuator>
    <position name="ax" joint="fx" kp="300" forcerange="-20 20"/>
    <position name="ay" joint="fy" kp="300" forcerange="-20 20"/>
    <position name="ayaw" joint="fyaw" kp="2" forcerange="-2 2"/>
    <position name="abend" joint="fbend" kp="0.5" forcerange="-0.5 0.5"/>
  </actuator>
</mujoco>
